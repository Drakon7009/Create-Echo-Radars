{
  "multipart": [
    { "apply": { "model": "create_echo_radars:block/copper_sonar_glass_pane_post" } },
    { "apply": { "model": "create_echo_radars:block/sonar_glass_pane_filter_post" } },
    { "when": { "north": "true" }, "apply": { "model": "create_echo_radars:block/copper_sonar_glass_pane_side" } },
    { "when": { "north": "true" }, "apply": { "model": "create_echo_radars:block/sonar_glass_pane_filter_side" } },
    { "when": { "east": "true" }, "apply": { "model": "create_echo_radars:block/copper_sonar_glass_pane_side", "y": 90 } },
    { "when": { "east": "true" }, "apply": { "model": "create_echo_radars:block/sonar_glass_pane_filter_side", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "create_echo_radars:block/copper_sonar_glass_pane_side_alt" } },
    { "when": { "south": "true" }, "apply": { "model": "create_echo_radars:block/sonar_glass_pane_filter_side_alt" } },
    { "when": { "west": "true" }, "apply": { "model": "create_echo_radars:block/copper_sonar_glass_pane_side_alt", "y": 90 } },
    { "when": { "west": "true" }, "apply": { "model": "create_echo_radars:block/sonar_glass_pane_filter_side_alt", "y": 90 } },
    { "when": { "north": "false" }, "apply": { "model": "create_echo_radars:block/copper_sonar_glass_pane_noside" } },
    { "when": { "north": "false" }, "apply": { "model": "create_echo_radars:block/sonar_glass_pane_filter_noside" } },
    { "when": { "east": "false" }, "apply": { "model": "create_echo_radars:block/copper_sonar_glass_pane_noside_alt" } },
    { "when": { "east": "false" }, "apply": { "model": "create_echo_radars:block/sonar_glass_pane_filter_noside_alt" } },
    { "when": { "south": "false" }, "apply": { "model": "create_echo_radars:block/copper_sonar_glass_pane_noside_alt", "y": 90 } },
    { "when": { "south": "false" }, "apply": { "model": "create_echo_radars:block/sonar_glass_pane_filter_noside_alt", "y": 90 } },
    { "when": { "west": "false" }, "apply": { "model": "create_echo_radars:block/copper_sonar_glass_pane_noside", "y": 270 } },
    { "when": { "west": "false" }, "apply": { "model": "create_echo_radars:block/sonar_glass_pane_filter_noside", "y": 270 } }
  ]
}
